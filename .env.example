# ─────────────────────────────────────────────────────────────────────────────
# Forge configuration. Copy to `.env.local` and edit. Every value is optional —
# Forge boots with sane defaults and everything here can also be set from the
# in-app Settings page (which writes to the database and takes precedence).
# ─────────────────────────────────────────────────────────────────────────────

# Where the SQLite database, downloaded models and caches live.
FORGE_DATA_DIR=./data
FORGE_DB_PATH=./data/forge.db

# ── LLM backends ─────────────────────────────────────────────────────────────
# Ollama (default backend — https://ollama.com)
OLLAMA_BASE_URL=http://127.0.0.1:11434

# llama.cpp server (`llama-server -m model.gguf --port 8080`)
LLAMACPP_BASE_URL=http://127.0.0.1:8080

# Any OpenAI-compatible server: vLLM, LM Studio, TGI, text-generation-webui, ...
OPENAI_COMPAT_BASE_URL=http://127.0.0.1:8000/v1
OPENAI_COMPAT_API_KEY=

# Model used to embed memories. Must be pulled in Ollama first:
#   ollama pull nomic-embed-text
# If it is unavailable Forge falls back to a local hashing embedder so memory
# still works offline with zero setup (lower quality, but never breaks).
FORGE_EMBEDDING_MODEL=nomic-embed-text

# ── Hugging Face ─────────────────────────────────────────────────────────────
# Token with `write` scope for pushing conversations/memories to a private repo,
# and `read` scope for downloading gated models. https://hf.co/settings/tokens
HF_TOKEN=
# Private dataset repo that backs up your data, e.g. "your-name/forge-vault"
HF_BACKUP_REPO=

# ── Obsidian ─────────────────────────────────────────────────────────────────
# Absolute path to your vault, e.g. /Users/you/Documents/Vault
OBSIDIAN_VAULT_PATH=

# ── Web search ───────────────────────────────────────────────────────────────
# Provider: "duckduckgo" (no key, default), "searxng", "tavily", "brave"
FORGE_SEARCH_PROVIDER=duckduckgo
SEARXNG_BASE_URL=
TAVILY_API_KEY=
BRAVE_API_KEY=
